#!/bin/sh
# Bumps the service worker cache version before every commit.
# Uses only sh + sed + date — all bundled with Git for Windows. No extra runtime needed.
# Activate once with: git config core.hooksPath .githooks

STAMP=$(date +%Y%m%d%H%M%S)
NEW="funance-${STAMP}"

sed -i "s/const CACHE = 'funance-[^']*'/const CACHE = '${NEW}'/" sw.js
# Keep the visible in-app build stamp in sync with the SW cache version,
# so you can tell at a glance which build your device is actually running.
sed -i "s/const BUILD = 'funance-[^']*'/const BUILD = '${NEW}'/" index.html

git add sw.js index.html
echo "SW cache version: ${NEW}"
